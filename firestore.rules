rules_version = '2';

// Firestore セキュリティルール
// content/* … 公開コンテンツ（今月のおまかせ等）。閲覧は誰でも可、
//             編集はログイン済みの管理者のみ。
service cloud.firestore {
  match /databases/{database}/documents {

    match /content/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 既定で他コレクションは全拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
